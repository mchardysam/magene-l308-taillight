<?xml version="1.0" encoding="UTF-8"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application entry="L308App" id="4e152a2d5f9a4f9c9b363d47f3742ec0" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.1.0" name="@Strings.AppName" type="watch-app">
        <!--
          Targets: any Connect IQ device that supports Toybox.BluetoothLowEnergy (CIQ >= 3.1).
          Declaring the BluetoothLowEnergy permission makes the compiler REJECT any product that
          lacks BLE, so this list can only contain BLE-capable devices. Below is a high-confidence
          starter set (fr965 is the on-hand test device). To add the rest of the BLE-capable fleet
          typo-free, use the VS Code Monkey C extension command "Monkey C: Edit Products" — it only
          offers product ids your installed SDK actually has. More BLE ids to add there if present:
          edge1050, edgeexplore2, fenix8*, epix2pro*, venu2/venu3, descentmk2/mk3, marq2*, etc.
          If a build errors with "unknown product id", just remove that one line (your SDK lacks it).
        -->
        <iq:products>
            <iq:product id="fr965"/>
            <iq:product id="fr955"/>
            <iq:product id="fr945"/>
            <iq:product id="fr745"/>
            <iq:product id="edge530"/>
            <iq:product id="edge830"/>
            <iq:product id="edge1030"/>
            <iq:product id="edge1040"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <iq:product id="epix2"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="BluetoothLowEnergy"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
